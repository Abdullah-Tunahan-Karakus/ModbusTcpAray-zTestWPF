<Window x:Class="ModbusTcpArayüzTestWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ModbusTcpArayüzTestWPF"
        mc:Ignorable="d"
        Title="Modbus (TCP) Test" Height="600" Width="800" Background="#F5F6FA" FontFamily="Segoe UI">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <!--Bağlantı Yeri-->
        <GroupBox Header="Bağlantı Ayarları" Grid.Row="0" Grid.Column="0" Margin="5" Padding="10" FontWeight="Bold">
            <StackPanel>
                <TextBlock Text="Ip Adresi: " Margin="0,0,0,5"/>
                <TextBox x:Name="txtIp" Text="127.0.0.1" Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="Port: " Margin="0,0,0,6"/>
                <TextBox x:Name="txtPort" Text="502" Padding="5" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnConnect" Content="Connect" Background="#4CAF50" Foreground="White" Padding="10" Margin="0,0,5,0" Click="btnConnect_Click"/>
                    <Button x:Name="btnDisconnect" Content="Disconnect" Background="#F44436" Foreground="White" Padding="10" Margin="5,0,0,0" Click="btnDisconnect_Click" Grid.Column="1"/>
                </Grid>
            </StackPanel>
        </GroupBox>
        <!--Okuma İşlemi(FNC03)-->
        <GroupBox Header="Veri Okuma (FC 03)" Grid.Row="0" Grid.Column="1" Margin="5" Padding="10" FontWeight="Bold">
            <StackPanel >
                <TextBlock Text="Başlangıç Adresi: " Margin="0,0,0,5" />
                <TextBox x:Name="txtReadAddress" Text="40001" Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="Okunacak Adet: " Margin="0,0,0,5" />
                <TextBox x:Name="txtReadQuantatiy" Text="3" Padding="5" Margin="0,0,0,10"/>

                <Button x:Name="btnRead" Content="Read" Background="#2196F3" Foreground="White" Padding="10" Click="btnRead_Click"/>
            </StackPanel>
        </GroupBox>
        <!--Tekli Yazma (FNC06) -->
        <GroupBox Header="Tekli Yazma (FC 06)" Grid.Row="1" Grid.Column="0" Margin="5" Padding="10" FontWeight="Bold">
            <StackPanel>
                <TextBlock Text="Hedef Adres: " Margin="0,0,0,5"/>
                <TextBox x:Name="txtWriteSingleAddress" Text="40001" Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="Yazılcak Değer: " Margin="0,0,0,5"/>
                <TextBox x:Name="txtWriteSingleValue" Text="999" Padding="5" Margin="0,0,0,10"/>

                <Button x:Name="btnWriteSingle" Content="SWrite" Background="#FF9890" Foreground="White" Padding="10" Click="btnWriteSingle_Click"/>
            </StackPanel>
        </GroupBox>
        <!--Çoklu Yazma (FNC16) -->
        <GroupBox Header="Çoklu Yazma (FC16)" Grid.Row="1" Grid.Column="1" Margin="5" Padding="10" FontWeight="Bold">
            <StackPanel>
                <TextBlock Text="Başlangıç Adresi: " Margin="0,0,0,5"/>
                <TextBox x:Name="txtWriteMultiAddress" Text="40001" Padding="5" Margin="0,0,0,10"/>


                <TextBlock Text="Değerler (Virgül ile ayırın): " Margin="0,0,0,5"/>
                <TextBox x:Name="txtWriteMultiValues" Text="500,150,5" Padding="5" Margin="0,0,0,10"/>

                <Button x:Name="btnWriteMulti" Content="MWrite" Background="#9C27B0" Foreground="White" Padding="10" Click="btnWriteMulti_Click" />
            </StackPanel>
        </GroupBox>
        <!-- Log Ekranı -->
        <GroupBox Header="Sistem Logları" Grid.Row="2" Grid.ColumnSpan="2" Margin="5" Padding="5" FontWeight="Bold">
            <TextBox x:Name="txtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#2D2D30" Foreground="#00FF00" FontFamily="Consolas" FontWeight="Normal" TextWrapping="Wrap"/>
        </GroupBox>
    </Grid>
</Window>
